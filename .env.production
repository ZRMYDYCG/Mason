# 本地环境
VITE_PROD = true
VITE_USER_NODE_ENV = production
# 开发环境接口地址
VITE_API_URL = /api
# 打包时是否删除 console
VITE_DROP_CONSOLE = true
# 是否启用前端 mock；Vercel 演示部署可在环境变量中设置为 true
VITE_MOCK = true
# 构建产物分析（rollup-plugin-visualizer），默认关闭
VITE_REPORT = false
# 图片压缩；Vercel/CI 会自动跳过 imagemin，本地如需关闭可设为 false
# VITE_IMAGEMIN = false
